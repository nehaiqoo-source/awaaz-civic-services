# Copy to .env and fill in only what you need. Every variable is optional:
# the app starts with `docker compose up` and works without any of them.
# Never commit a real .env file.

# Anthropic API key for the optional AI features (smarter form filling, Saathi "look closer",
# turning a spoken complaint into a structured draft). Server-side only; never prefix with NEXT_PUBLIC_.
# If unset, the app uses its built-in keyword rules and the UI says the AI service is not set up.
# Example: ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Vercel Blob token for storing complaints and photos in the cloud.
# If unset, complaints are saved to a JSON file under ./data (a Docker volume in compose.yaml).
# Example: BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
BLOB_READ_WRITE_TOKEN=

# Where to store complaints when Blob is not used. Default: ./data/grievances.json
GRIEVANCE_DATA_FILE=

# Google Search Console verification code (only for the public website).
GOOGLE_SITE_VERIFICATION=

# Server address baked into the browser extension at build time. Default: https://awaaz-civic.vercel.app
AWAAZ_API_BASE=

# Mobile app (mobile/ folder, Expo) only: server the app talks to. Release builds default to https://www.awaaz.help
EXPO_PUBLIC_API_BASE=
